# HTTP and WS must use the exact same JWT_SECRET.
JWT_SECRET=change-me

# Neon (set on both HTTP and WS)
DATABASE_URL=
# Direct (no -pooler in the host). Prisma migrate needs this; the pooled URL will time out.
DATABASE_URL_UNPOOLED=

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Next.js
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_WS_BACKEND_URL=ws://localhost:8081

# Production (Render): comma-separated site origins that may call the HTTP API
FRONTEND_URL=http://localhost:3000

# Vercel team slug. Preview origins are allowed only as
# board-house-<branch-or-id>-<VERCEL_TEAM_SLUG>.vercel.app
VERCEL_TEAM_SLUG=
