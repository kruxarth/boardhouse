// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id                  String   @id @default(cuid())
  slug                String   @unique
  hostKey             String   @unique
  hostParticipantId   String
  hostName            String   @default("")
  accessMode          String
  name                String?
  formerSlugs         String[] @default([])
  createdAt           DateTime @default(now())
  expiresAt           DateTime
  /** Null while someone is seated. Set when the last person leaves, or on create. After EMPTY_TABLE_MS the house offers the table for claim. */
  emptySince          DateTime?
  /** People currently in seats. The WebSocket server updates this as they come and go. */
  seated              Int      @default(0)
  /** Latest board. The WebSocket server writes this every few seconds so a restart does not wipe strokes. */
  canvas              Json?

  @@index([expiresAt])
  @@index([emptySince])
}
